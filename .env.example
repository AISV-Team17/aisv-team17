# ===================================================
# AISV Team17 — .env.example
# cp .env.example .env  →  vim .env 에서 값 채우기
# 절대 커밋 금지. 실제 비밀값은 GitHub Secrets에서 관리.
# ===================================================


# Docker / Compose
COMPOSE_PROJECT_NAME=aisv
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml  # 로컬 override 시 주석 해제


# PostgreSQL
POSTGRES_HOST_PORT=5433
POSTGRES_USER=aisv
POSTGRES_PASSWORD=
POSTGRES_DB=aisv_db
DATABASE_URL=postgresql+asyncpg://aisv:<PASSWORD>@postgres:5432/aisv_db

# Redis
REDIS_HOST_PORT=6380
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# OpenTelemetry Collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=rag-service

# LLM API — Anthropic Claude
ANTHROPIC_API_KEY=
# 생성(소형) / 채점·에이전트(중형) 등급 분리
LLM_GEN_MODEL=claude-haiku-3-5
LLM_JUDGE_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_JUDGE_TIMEOUT_SECONDS=60
LLM_BUDGET_USD=200

# HuggingFace Hub
HF_TOKEN=
HF_HOME=/models/hf-cache
# 1단계 탐지 모델
DETECTOR_REPO=KRLabsOrg/lettucedect-base-modernbert-en-v1
DETECTOR_REVISION=
DETECTOR_FORMAT=onnx-int8
# 임베딩 모델 (CPU 로컬 서빙 — Claude API 불필요)
EMBEDDING_REPO=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REVISION=

# RAG 서비스 (backend/src/rag/)
RAG_PORT=8001
VECTOR_DB_PATH=/app/chroma

# Ingest API (backend/src/ingest/)
INGEST_PORT=8002
INGEST_BATCH_SIZE=100

# Worker (backend/src/worker/)
WORKER_ONNX_THRESHOLD=0.6
WORKER_SAMPLE_RATE=0.05
WORKER_LLM_STAGE_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=4
WORKER_BATCH_WAIT_SECONDS=2
WORKER_BATCH_SIZE=16

# Drift Monitor (backend/src/drift/)
DRIFT_WINDOW_MINUTES=5
DRIFT_THRESHOLD_RATIO=0.3
DRIFT_INCIDENT_COOLDOWN_MINUTES=15

# Agent (backend/src/agent/)
AGENT_PORT=8004
AGENT_DB_DSN=postgresql://aisv_readonly:<PASSWORD>@postgres:5432/aisv_db
AGENT_MAX_CALLS=12
AGENT_MAX_TOKENS=60000

# Console (backend/src/console/)
CONSOLE_PORT=8005
CONSOLE_SECRET_KEY=
CONSOLE_ADMIN_EMAIL=admin@example.com
CONSOLE_ADMIN_PASSWORD=

# Frontend (Next.js)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Grafana
GRAFANA_PORT=3001
GF_SECURITY_ADMIN_PASSWORD=

# Slack 알림
SLACK_WEBHOOK_URL_QUALITY=
SLACK_WEBHOOK_URL_OPS= 

# 운영 서버 (Vultr) — 로컬 개발 시 불필요
VULTR_SERVER_IP=
IMAGE_TAG=latest